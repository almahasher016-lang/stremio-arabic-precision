NODE_ENV=production
# Railway injects PORT; no need to set it manually.
PUBLIC_BASE_URL=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_TOKEN=
SUBDL_API_KEY=
SUBSOURCE_API_KEY=
SUBSOURCE_BASE_URL=https://api.subsource.net/api/v1
# Optional reference synchronization is disabled by default.
ENABLE_REFERENCE_SYNC=false
ALASS_BINARY=alass
SEARCH_TIMEOUT_MS=3500
DOWNLOAD_TIMEOUT_MS=9000
REQUEST_DEADLINE_MS=6000
SEARCH_CACHE_TTL_MS=600000
NEGATIVE_CACHE_TTL_MS=45000
CONTENT_CACHE_TTL_MS=86400000
MAX_SUBTITLES=12
MAX_DOWNLOAD_BYTES=5242880
LINK_SIGNING_SECRET=
SUBTITLE_PROVIDERS=opensubtitles,subdl,subsource
DATA_DIR=
